using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.Audio;
using System.Collections;

public class Microwave_timer : MonoBehaviour
{
    [Header("Timer Settings")]
    [Tooltip("Total countdown time in seconds")]
    public float durationSeconds = 60f;
    [Tooltip("Periodic SFX interval in seconds. Set to 0 to disable periodic SFX.")]
    public float periodicIntervalSeconds = 15f;
    [Tooltip("Radius around this object where the player can toggle the timer using the E key")]
    public float activationRadius = 2f;
    [Tooltip("assign the player transform")]
    public Transform player;

    [Header("Audio")]
    public AudioSource audioSource; // assign in editor
    public AudioClip endSfx;
    public AudioClip periodicSfx;
    [Tooltip("Background looping clip that plays while the timer runs.")]
    public AudioClip backgroundLoopClip;
    [Tooltip("Optional separate AudioSource for the looping background clip. If null one will be created at runtime.")]
    public AudioSource loopAudioSource;
    [Tooltip("Gain in dB to apply to the end SFX (can be negative). +5 dB is default.")]
    public float endSfxGainDb = 5f;
    [Tooltip("Mixer group to use for end SFX (beep)")]
    public AudioMixerGroup beepGroup;
    [Tooltip("Mixer group to use for all other SFX (idle on)")]
    public AudioMixerGroup idleOnGroup;
    [Header("End Sequence")]
    [Tooltip("Canvas to enable when the timer ends. Assign from the editor.")]
    public Canvas loseScreenCanvas;

    bool endSequenceStarted = false;

    public float timeRemaining;
    float elapsed;
    bool running;
    float nextPeriodicTrigger;
    [SerializeField] bool playerInRange;

    void Awake()
    {
        timeRemaining = durationSeconds;
        elapsed = 0f;
        running = false;
        nextPeriodicTrigger = periodicIntervalSeconds;

        if (audioSource == null)
            audioSource = GetComponent<AudioSource>();

        // Ensure there is an audio source dedicated to the looping background sound.
        if (loopAudioSource == null)
        {
            // create a child GameObject to host the loop audio source
            var go = new GameObject("LoopAudioSource");
            go.transform.SetParent(transform);
            go.transform.localPosition = Vector3.zero;
            loopAudioSource = go.AddComponent<AudioSource>();
            loopAudioSource.playOnAwake = false;
            loopAudioSource.loop = true;
        }

        // assign mixer group for loop source if available
        if (idleOnGroup != null)
            loopAudioSource.outputAudioMixerGroup = idleOnGroup;

        // if a clip was assigned in the editor, attach it but do not play yet
        if (backgroundLoopClip != null)
            loopAudioSource.clip = backgroundLoopClip;

        // Ensure lose screen is hidden at start if assigned
        if (loseScreenCanvas != null)
            loseScreenCanvas.gameObject.SetActive(false);
    }

    void FixedUpdate()
    {
        if (!running) return;

        // advance timer with fixed delta
        elapsed += Time.fixedDeltaTime;
        timeRemaining -= Time.fixedDeltaTime;

        // periodic SFX
        if (periodicIntervalSeconds > 0f && periodicSfx != null && elapsed >= nextPeriodicTrigger)
        {
            PlayOneShot(periodicSfx);
            // schedule next
            nextPeriodicTrigger += periodicIntervalSeconds;
        }
        // end of timer
        if (elapsed >= durationSeconds)
        {
            running = false;
            elapsed = durationSeconds;
            // stop any currently playing periodic sounds before playing the end SFX
            if (audioSource != null)
            {
                audioSource.Stop();
            }
            if (endSfx != null) PlayOneShot(endSfx);
            OnTimerEnd();

            // start end sequence: after 2 seconds, stop game time and enable lose screen
            if (!endSequenceStarted)
                StartCoroutine(EndSequenceCoroutine());
        }
    }

    IEnumerator EndSequenceCoroutine()
    {
        endSequenceStarted = true;
        // wait 2 seconds in real time before pausing and showing lose UI
        yield return new WaitForSecondsRealtime(2f);

        // enable lose screen if assigned
        if (loseScreenCanvas != null)
            loseScreenCanvas.gameObject.SetActive(true);

        // stop game time
        Time.timeScale = 0f;
    }

    void Update()
    {
        // check player proximity
        playerInRange = false;
        if (player != null)
        {
            float d = Vector2.Distance(new Vector2(transform.position.x, transform.position.y), new Vector2(player.position.x, player.position.y));
            playerInRange = d <= activationRadius;
        }

        // toggle with E (Input System only)
        var kb = Keyboard.current;
        if (playerInRange && kb.eKey.wasPressedThisFrame)
        {
            if (running) StopTimer(); else StartTimer();
        }
    }
    void PlayOneShot(AudioClip clip)
    {
        if (audioSource != null)
        {
            // Route end-of-timer SFX to the beep mixer group, everything else to idle on group.
            if (clip == endSfx && beepGroup != null)
            {
                audioSource.outputAudioMixerGroup = beepGroup;
            }
            else if (idleOnGroup != null)
            {
                audioSource.outputAudioMixerGroup = idleOnGroup;
            }

            // Compute linear gain multiplier from dB setting for end SFX
            float volumeScale = 1f;
            if (clip == endSfx)
            {
                // dB -> linear multiplier: 10^(dB/20)
                volumeScale = Mathf.Pow(10f, endSfxGainDb / 20f);
            }

            audioSource.PlayOneShot(clip, volumeScale);
        }
    }

    // API
    public void StartTimer()
    {
        elapsed = 0f;
        running = true;
        // Play the periodic SFX once immediately when the timer starts, then schedule the next play
        if (periodicIntervalSeconds > 0f && periodicSfx != null)
        {
            PlayOneShot(periodicSfx);
        }
        nextPeriodicTrigger = periodicIntervalSeconds > 0f ? periodicIntervalSeconds : float.PositiveInfinity;
    }

    public void StopTimer()
    {
        running = false;
    }

    // removed ResetTimer per request. Timer can be started/stopped via StartTimer/StopTimer and toggled by E when player is close.

    public float TimeRemaining() => Mathf.Max(0f, durationSeconds - elapsed);
    public float TimeElapsed() => elapsed;
    public bool IsRunning() => running;

    // hook for additional behavior
    protected virtual void OnTimerEnd()
    {
        // override or subscribe to further behavior in derived scripts
    }
}
