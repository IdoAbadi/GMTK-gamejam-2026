using UnityEngine;
using TMPro;

public class CatMinigameManager : MonoBehaviour
{
    [SerializeField] private int foodNeededToWin = 15;

    [Header("UI")]
    [SerializeField] private TMP_Text foodText;
    [SerializeField] private TMP_Text resultText;
    [SerializeField] private Canvas Win_screen;
    private int foodCaught;
    private bool gameEnded;

    private void Start()
    {
        UpdateUI();

        if (resultText != null)
        {
            resultText.text = "";
        }
    }

    public void CatchFood()
    {
        if (gameEnded)
            return;

        foodCaught++;
        UpdateUI();

        Debug.Log("Food: " + foodCaught + " / " + foodNeededToWin);

        if (foodCaught >= foodNeededToWin)
        {
            EndGame(true);
        }
    }

    public void MissFood()
    {
        if (gameEnded)
            return;

        // Miss penalty removed: missing food no longer advances misses or ends the game.
        // Game will continue until EndGame(true) is called when enough food is caught.
        Debug.Log("Food missed - no penalty. Game continues.");
    }

    private void UpdateUI()
    {
        if (foodText != null)
        {
            foodText.text =
                "Food: " + foodCaught + " / " + foodNeededToWin;
        }

        if (missesText != null)
        {
            missesText.text =
                "Misses: " + misses + " / " + maximumMisses;
        }
    }

    private void EndGame(bool playerWon)
    {
        gameEnded = true;

        FoodSpawner foodSpawner =
            FindFirstObjectByType<FoodSpawner>();

        if (foodSpawner != null)
        {
            foodSpawner.StopSpawning();
        }

        FallingItem[] remainingFood =
            FindObjectsByType<FallingItem>(
                FindObjectsSortMode.None
            );

        foreach (FallingItem food in remainingFood)
        {
            food.DropAfterWin();
        }

        if (playerWon)
        {
            Win_screen.gameObject.SetActive(true);
            //resultText.text = "YOU WIN!";
            //resultText.color = Color.green;
            //Debug.Log("CAT MINIGAME WON!");
        }
        else
        {
            //resultText.text = "YOU LOSE!";
            //resultText.color = Color.red;
            //Debug.Log("CAT MINIGAME LOST!");
        }
    }
}