using System.Collections;
using UnityEngine;

[RequireComponent(typeof(AudioSource))]
public class loopDelayAudio : MonoBehaviour
{
    [Tooltip("Delay in seconds after the clip finishes before it plays again")]
    [SerializeField]
    private float delay = 1f;

    [Tooltip("If true the loop will start automatically when the object is enabled")]
    [SerializeField]
    private bool playOnEnable = true;

    [SerializeField] AudioSource audioSource;
    Coroutine loopCoroutine;

    void OnEnable()
    {
        if (playOnEnable)
            StartLoop();
    }

    void OnDisable()
    {
        StopLoop();
    }

    // Start the looping behavior (can be called from other scripts)
    public void StartLoop()
    {
        if (loopCoroutine == null)
            loopCoroutine = StartCoroutine(LoopRoutine());
    }

    // Stop the looping behavior
    public void StopLoop()
    {
        if (loopCoroutine != null)
        {
            StopCoroutine(loopCoroutine);
            loopCoroutine = null;
        }
        if (audioSource != null)
            audioSource.Stop();
    }

    IEnumerator LoopRoutine()
    {
        while (true)
        {
            if (audioSource == null || audioSource.clip == null)
                yield break;

            audioSource.Play();

            // wait for clip length plus configured delay
            float waitTime = audioSource.clip.length + Mathf.Max(0f, delay);
            yield return new WaitForSeconds(waitTime);
        }
    }

    void OnValidate()
    {
        if (delay < 0f) delay = 0f;
    }
}
